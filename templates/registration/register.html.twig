{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container m-5">

    <h1>Formulaire d'inscription</h1>

    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">
            <div>{{ form_row(form.firstname) }}</div>
            <div>{{ form_row(form.lastname) }}</div>
            <div>{{ form_row(form.roles) }}</div>
        </div>
        <div class="col-md-6">
            <div>{{ form_row(form.username) }}</div>
            <div>{{ form_row(form.email) }}</div>
            <div>{{ form_row(form.password) }}</div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary">Je m'inscris</button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

</div>
{% endblock %}

